# Виртуальное окружение
.venv/
venv/
env/
ENV/

# Кеш и артефакты Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# Настройки IDE
.idea/
.vscode/
*.iml

# Артефакты тестов и отчёты
.pytest_cache/
allure-results/
allure-report/
locust-reports/
*.log

# Секреты и локальные настройки
# (.env с настройками учебного стенда хранится в репозитории — его читает config.py)
.env.local

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# Токены и ключи - никогда не коммитить
Token.txt
token.txt
*token*.txt
*.pem
*.key
credentials*
